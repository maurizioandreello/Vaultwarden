# Configurazione Vaultwarden — copiare in /srv/vaultwarden/.env (root:root 600).
# Riferimento completo: .env.template del tag in uso (1.37.4):
# https://github.com/dani-garcia/vaultwarden/blob/1.37.4/.env.template
#
# NOTA BENE sui '$': Docker Compose (v2+) interpola i valori dei file env_file
# che NON sono tra apici singoli: '$x' verrebbe espanso come variabile. Per i
# valori che contengono '$' (come l'hash Argon2) usare SEMPRE gli apici singoli:
# gli apici vengono rimossi dal parser e il valore arriva letterale al container.

DOMAIN=https://pass.gatet1.it

# Porta HTTP nel container: non privilegiata, obbligatoria perche' il
# processo gira come uid 10003 (compose.yaml: user 10003:10003).
ROCKET_PORT=8080
TZ=Europe/Rome

# Registrazioni chiuse: gli utenti entrano SOLO su invito dell'organizzazione.
SIGNUPS_ALLOWED=false
SIGNUPS_VERIFY=true
# NON impostare MAI SIGNUPS_DOMAINS_WHITELIST: permetterebbe a chiunque abbia
# una casella sul dominio di registrarsi da solo anche con signups chiusi.

# Inviti dagli admin dell'organizzazione (scadenza token 72h).
INVITATIONS_ALLOWED=true
INVITATION_ORG_NAME='Gate T1'
INVITATION_EXPIRATION_HOURS=72

# Solo questo utente puo' creare organizzazioni.
ORG_CREATION_USERS=maurizio.andreello@gatet1.it

# Gruppi (feature beta di vaultwarden, necessari all'import utenti di fase 2)
# e log eventi dell'organizzazione conservati 2 anni.
ORG_GROUPS_ENABLED=true
ORG_EVENTS_ENABLED=true
EVENTS_DAYS_RETAIN=730

# Superficie ridotta: niente emergency access, niente Bitwarden Send,
# niente suggerimenti password (ne' impostabili ne' visibili senza SMTP).
EMERGENCY_ACCESS_ALLOWED=false
SENDS_ALLOWED=false
PASSWORD_HINTS_ALLOWED=false
SHOW_PASSWORD_HINT=false

# Token del pannello /admin (hash Argon2 PHC, NON la password in chiaro).
# Generarlo sul server:
#   docker run --rm -it vaultwarden/server:1.37.4 /vaultwarden hash
# e incollare l'output '$argon2id$...' QUI SOTTO tra apici singoli (vedi nota
# sui '$' in testa: tra apici singoli Compose non espande nulla).
# Dopo il setup iniziale si puo' svuotare ADMIN_TOKEN (valore vuoto) per
# disattivare del tutto il pannello admin.
ADMIN_TOKEN='CHANGEME_argon2'

# Durata della sessione del pannello admin (minuti).
ADMIN_SESSION_LIFETIME=20

# nginx sull'host passa l'IP client reale in X-Real-IP. Il container vede
# come sorgente il gateway del bridge docker (rete `vault`, nel pool
# 10.201.0.0/16 del server): l'header e' accettato SOLO da li'. Chiunque
# raggiunga il container direttamente (rete vault, fase 2) non puo'
# falsificare l'IP client, che serve a rate limit e log.
IP_HEADER=X-Real-IP
IP_HEADER_TRUSTED_PROXIES=10.201.0.0/16

# SMTP — stesso relay di secmon, mittente dedicato pass@gatet1.com.
SMTP_HOST=authsmtp.securemail.pro
SMTP_PORT=465
SMTP_SECURITY=force_tls
SMTP_FROM=pass@gatet1.com
SMTP_FROM_NAME='Gate T1 Password'
SMTP_USERNAME=smtp@gatet1.com
SMTP_PASSWORD=CHANGEME

# Nessuna push notification mobile (richiederebbe account bitwarden.com):
# lasciare disabilitato. Le notifiche ai client passano dal websocket
# interno (ENABLE_WEBSOCKET di default true, gia' coperto da nginx).
# PUSH_ENABLED=false
